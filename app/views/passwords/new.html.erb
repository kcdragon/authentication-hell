<% content_for :title, "Reset your password" %>
<% content_for :meta_description, "Forgot your Authentication Hell password? Enter your email and we'll send a link to choose a new one." %>

<% content_for :head do %>
  <meta name="robots" content="noindex, follow">
<% end %>

<div class="mx-auto max-w-md w-full ah-card p-6">
  <h1 class="text-[28px]">Forgot your password?</h1>

  <p class="mt-4 font-medium text-muted">
    Enter the email address on your account and we'll send you a link to choose a new password.
  </p>

  <%= form_with url: passwords_path, class: "mt-4 space-y-3.5" do |form| %>
    <div class="space-y-1.5">
      <%= form.label :email_address, "Email", class: "ah-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "player@example.com", value: params[:email_address], class: "ah-input" %>
    </div>

    <%= form.submit "Email reset instructions", class: "ah-btn ah-btn--primary shadow-brut cursor-pointer" %>
  <% end %>

  <p class="mt-6 font-medium text-sm text-muted">
    <%= link_to "Back to sign in", new_session_path, class: "text-ink underline underline-offset-[3px] decoration-2 hover:no-underline" %>
    &middot;
    <%= link_to "Create an account", new_registration_path, class: "text-ink underline underline-offset-[3px] decoration-2 hover:no-underline" %>
  </p>
</div>
